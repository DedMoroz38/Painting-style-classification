# Note: comments must be on their own line in .gitignore.

# ===================================================================
# Data and course material (too big, or not ours to publish)
# ===================================================================
# 7.8 GB of images; download from Kaggle: sivarazadi/wikiart-art-movementsstyles
data/
# lecture slides and coursework spec (university material)
docs/

# ===================================================================
# Generated by the scripts (large; rebuild by running the pipeline)
# ===================================================================
# extracted features and embeddings
*.npz
# visual-word vocabulary
*.npy
# trained models (up to 1.4 GB each)
*.joblib
# CLIP / DINOv2 embeddings and their chunks
outputs/deep/embeddings/
# grids of misclassified WikiArt paintings (image copyright)
**/misclassified.png

# ===================================================================
# Report build files (keep report.tex, references.bib, figures/ and report.pdf)
# ===================================================================
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# submission archive (built from the repo when submitting)
*.zip

# ===================================================================
# Secrets (never commit)
# ===================================================================
.env
kaggle.json
*.pem
*.key

# ===================================================================
# Python, editors, OS
# ===================================================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.vscode/
.idea/
*.swp
.DS_Store
.claude/settings.local.json
